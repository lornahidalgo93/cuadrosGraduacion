<section id="galeria" class="seccion seccion-galeria">
  <div class="container">
    <p class="eyebrow text-center">Trabajos entregados</p>
    <h2 class="titulo-seccion text-center">Galería</h2>
    <p class="text-center subtitulo-seccion mx-auto">
      Algunos de los cuadros que ya hemos entregado a nuestros clientes.
      Haz click en cualquier foto para verla más grande.
    </p>

    <div class="grilla-galeria mt-4">
      {{#each galeria}}
      <button
        type="button"
        class="pieza-galeria {{#if this.destacado}}pieza-destacada{{/if}}"
        data-imagen="{{this.imagen}}"
        data-titulo="{{this.titulo}}"
        data-formato="{{this.formato}}"
        aria-label="Ver {{this.titulo}} en grande"
      >
        <img src="{{this.imagen}}" alt="{{this.titulo}}" loading="lazy" />
        <span class="overlay-galeria">
          <span class="overlay-titulo">{{this.titulo}}</span>
          <span class="overlay-formato">{{this.formato}}</span>
        </span>
      </button>
      {{/each}}
    </div>
  </div>
</section>

{{!-- Lightbox único y reutilizable para toda la galería --}}
<div
  class="modal fade"
  id="lightbox-galeria"
  tabindex="-1"
  aria-hidden="true"
  data-whatsapp="{{negocio.whatsapp}}"
>
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-cuadro modal-lightbox">
      <button
        type="button"
        class="btn-close btn-close-lightbox"
        data-bs-dismiss="modal"
        aria-label="Cerrar"
      ></button>

      <button type="button" class="lightbox-flecha lightbox-flecha-izq" aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-imagen-contenedor">
        <img
          id="lightbox-imagen"
          src=""
          alt=""
          class="lightbox-imagen"
          title="Click para acercar o alejar"
        />
      </div>

      <button type="button" class="lightbox-flecha lightbox-flecha-der" aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-pie">
        <div>
          <p id="lightbox-titulo" class="lightbox-titulo mb-0"></p>
          <p id="lightbox-formato" class="lightbox-formato mb-0"></p>
        </div>
        <a
          id="lightbox-whatsapp"
          href="#"
          target="_blank"
          rel="noopener"
          class="btn btn-cta-primario"
        >
          Quiero uno así
        </a>
      </div>
    </div>
  </div>
</div>
