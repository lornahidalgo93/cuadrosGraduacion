<section id="productos" class="seccion seccion-productos">
  <div class="container">
    <p class="eyebrow text-center">Nuestros formatos</p>
    <h2 class="titulo-seccion text-center">Elige el tamaño de tu recuerdo</h2>
    <p class="text-center subtitulo-seccion mx-auto">
      Cada cuadro se confecciona a mano al recibir tu pedido. Todos incluyen la sesion fotografica, post edicion, impresion de calidad y marco
      
    </p>

    <div class="row g-4 mt-3">
      {{#each productos}}
      <div class="col-md-4">
        <div class="tarjeta-cuadro h-100">
          <div class="marco-foto">
            <img src="{{this.imagen}}" alt="Cuadro de graduación {{this.nombre}}" />

            <div class="dropdown compartir-wrapper">
              <button
                type="button"
                class="boton-compartir"
                id="compartir-{{this.id}}"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Compartir {{this.nombre}}"
                data-titulo="{{this.nombre}}"
                data-medida="{{this.medida}}"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L7.04 9.81C6.5 9.31 5.79 9 5 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
                </svg>
              </button>
              <ul class="dropdown-menu dropdown-menu-end menu-compartir" aria-labelledby="compartir-{{this.id}}">
                <li>
                  <a
                    class="dropdown-item item-compartir-whatsapp"
                    href="#"
                    data-titulo="{{this.nombre}}"
                    data-medida="{{this.medida}}"
                  >
                    Compartir por WhatsApp
                  </a>
                </li>
                <li>
                  <button
                    type="button"
                    class="dropdown-item item-copiar-enlace"
                    data-titulo="{{this.nombre}}"
                    data-medida="{{this.medida}}"
                  >
                    Copiar enlace para Instagram
                  </button>
                </li>
              </ul>
            </div>
          </div>
          <div class="tarjeta-cuerpo">
            <p class="eyebrow eyebrow-tarjeta">{{this.medida}}</p>
            <h3 class="nombre-producto">{{this.nombre}}</h3>
            <p class="descripcion-producto">{{this.descripcionCorta}}</p>
            <p class="precio-producto">{{formatoPrecio this.precio}}</p>
            <div class="d-grid gap-2">
              <button
                type="button"
                class="btn btn-cta-secundario"
                data-bs-toggle="modal"
                data-bs-target="#detalle-{{this.id}}"
              >
                Ver más detalles
              </button>
              <a
                class="btn btn-cta-primario"
                href="{{whatsappLink ../negocio.whatsapp (concat "Hola, quiero cotizar el " this.nombre " (" this.medida ")")}}"
                target="_blank"
                rel="noopener"
              >
                Contactar por WhatsApp
              </a>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>

{{!-- Modales de detalle, uno por producto --}}
{{#each productos}}
<div
  class="modal fade"
  id="detalle-{{this.id}}"
  tabindex="-1"
  aria-labelledby="detalle-{{this.id}}-label"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modal-cuadro">
      <div class="modal-header">
        <h3 class="modal-title" id="detalle-{{this.id}}-label">
          {{this.nombre}} <span class="modal-medida">({{this.medida}})</span>
        </h3>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Cerrar"
        ></button>
      </div>
      <div class="modal-body">
        <img
          src="{{this.imagen}}"
          alt="Cuadro de graduación {{this.nombre}}"
          class="img-fluid modal-imagen mb-3"
        />
        <p>{{this.descripcionLarga}}</p>
        <ul class="lista-materiales">
          {{#each this.materiales}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
        <p class="tiempo-entrega">
          <strong>Tiempo de entrega:</strong> {{this.tiempoEntrega}}
        </p>
        <p class="precio-modal">{{formatoPrecio this.precio}}</p>
      </div>
      <div class="modal-footer modal-footer-compartir">
        <a
          class="btn btn-cta-primario flex-grow-1"
          href="{{whatsappLink ../negocio.whatsapp (concat "Hola, quiero cotizar el " this.nombre " (" this.medida ")")}}"
          target="_blank"
          rel="noopener"
        >
          Contactar por WhatsApp
        </a>

        <div class="dropdown compartir-wrapper compartir-wrapper-modal">
          <button
            type="button"
            class="boton-compartir boton-compartir-modal"
            id="compartir-modal-{{this.id}}"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Compartir {{this.nombre}}"
            data-titulo="{{this.nombre}}"
            data-medida="{{this.medida}}"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L7.04 9.81C6.5 9.31 5.79 9 5 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"/>
            </svg>
          </button>
          <ul class="dropdown-menu dropdown-menu-end menu-compartir" aria-labelledby="compartir-modal-{{this.id}}">
            <li>
              <a
                class="dropdown-item item-compartir-whatsapp"
                href="#"
                data-titulo="{{this.nombre}}"
                data-medida="{{this.medida}}"
              >
                Compartir por WhatsApp
              </a>
            </li>
            <li>
              <button
                type="button"
                class="dropdown-item item-copiar-enlace"
                data-titulo="{{this.nombre}}"
                data-medida="{{this.medida}}"
              >
                Copiar enlace para Instagram
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
{{/each}}
